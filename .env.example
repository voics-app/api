# Dev-only values for running the api locally. Never reuse these anywhere else.
# The Ed25519 keys below are DEV ONLY and public in this repository.

DISCORDY_ENV=local
LOG_LEVEL=info
API_BIND_ADDR=0.0.0.0:8080

# P2 common
INTERNAL_SERVICE_TOKEN=dev-internal-token
SNOWFLAKE_WORKER_ID=1
KAFKA_BROKERS=localhost:19092
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIMUSpBJLionCBRJG3+Gqpzzppeq5Medf/9n4NGKkQMGk\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAbpnOpd3cyIuPfLFuJEbIRanfFOKTrZht7NT9WSmfnhA=\n-----END PUBLIC KEY-----

# P2 api
DATABASE_URL=postgres://discordy:discordy@localhost:5432/discordy
VALKEY_URL=redis://localhost:6379
PUBLIC_API_URL=http://localhost:8080
PUBLIC_GATEWAY_URL=ws://localhost:4000
CDN_PUBLIC_URL=http://localhost:9000
MESSAGES_INTERNAL_URL=http://localhost:8082
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-dev-secret
MINIO_BUCKET_ASSETS=discordy-assets
DEFAULT_VOICE_REGION=nl-home
CORS_ALLOWED_ORIGINS=null,http://localhost:5173

# Optional paired passkey configuration. The browser must run the ceremony at this origin.
# Native file:// renderers need an HTTPS ceremony surface or associated-domain OS bridge.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Optional: OTLP/HTTP collector for traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional Tenor-v2-compatible GIF service. Leave both unset to disable GIF search.
# Configure only a provider which permits server-side proxying and response caching.
# GIF_PROVIDER_URL=https://provider.example/v2/
# GIF_PROVIDER_KEY=
# GIF_MEDIA_HOSTS=media.provider.example
